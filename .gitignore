# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# The service worker that is actually served. `public/sw.source.js` is the tracked
# template; the build stamps a build id into a copy at this path. It is generated
# rather than committed so that a build does not leave the tree dirty with a
# per-deploy cache name.
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# The template is the one env file that belongs in the repo: it records which
# variables the app reads and what they need to be, which is the only way anyone
# cloning this knows what to set on a fresh host. It holds no real values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Externally sourced marking data and raw scrapes. Licensed material never goes in.
.cache/
corpus/sources.json
