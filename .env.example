# Environment template. Copy to `.env.local` for development, or set these in
# your host's dashboard for a deployment. No real values belong in this file.
#
# `npm run build` does NOT need JWT_SECRET. It is read only when a token is
# signed or verified, so a build without it succeeds and the failure surfaces on
# the first login instead. Set it before anyone tries to sign in.

# Postgres connection string. Required for accounts, sync and the sync/CDP code.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signing key for session and refresh tokens. Required in production, 32+
# characters, and the code has no fallback: it throws rather than invent a
# default, because a known default key would let anyone mint a valid session.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every existing session and refresh token.
JWT_SECRET=

# Supabase. Only needed for the hosted sync path; the app falls back to local
# storage when these are absent.
SUPABASE_URL=
SUPABASE_ANON_KEY=